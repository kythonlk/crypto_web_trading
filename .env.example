# MetaTrader credentials (optional in TEST_API mode)
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=

# Trading Mode: 'TEST_API' (uses public API & paper broker) or 'MT5' (live terminal)
BOT_MODE=TEST_API

# Symbol & Timeframe
TRADING_SYMBOL=BTCUSDT
TIMEFRAME=M15
STRATEGY=trend

# Risk Management Controls ("Minimal Loss" Philosophy)
MAX_RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_DRAWDOWN_PERCENT=3.0
MAX_OPEN_POSITIONS=2
RISK_REWARD_RATIO=2.0
ATR_MULTIPLIER_SL=1.5
BREAKEVEN_R_TRIGGER=1.0
TRAILING_STOP_ENABLED=True
MAX_SPREAD_POINTS=30.0

# Polling interval in seconds
POLL_INTERVAL_SECONDS=5.0
